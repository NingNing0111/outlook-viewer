# Copy to .env and adjust. Everything here is optional.

# Signs session cookies. Leave empty for a random key per start (logins reset on restart).
# Generate a stable one with:  openssl rand -hex 32
SECRET_KEY=

# Set to 1 when the app is served over HTTPS (recommended in production).
COOKIE_SECURE=0

# Host port bound to 127.0.0.1. Put a reverse proxy / tunnel in front.
HOST_PORT=8000

# Optional: prefills the clientid field on the page.
DEFAULT_CLIENT_ID=
